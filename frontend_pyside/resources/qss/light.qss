
QWidget {
    color: #101828;
    font-size: 12.5pt;
}
QMainWindow, QWidget#centralRoot, QScrollArea#pageScroll > QWidget > QWidget {
    background: #EEF1F5;
}
QToolTip {
    color: #101828;
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    padding: 6px 8px;
    font-size: 12pt;
}


QWidget#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #C7CDD6;
}
QLabel#topProject {
    color: #101828;
    font-weight: 700;
    font-size: 13.25pt;
}
QLabel#topMeta {
    color: #344054;
    background: #E6EAF0;
    border: 1px solid #C7CDD6;
    border-radius: 12px;
    padding: 4px 9px;
    font-size: 12pt;
}
QLabel#topMetric {
    color: #0A327A;
    background: #D6E4FF;
    border-radius: 11px;
    padding: 4px 9px;
    font-size: 12pt;
}
QWidget#navPanel { background: #101828; }
QLabel#brand {
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 700;
    padding: 20px 18px 7px 18px;
}
QLabel#brandSubtitle {
    color: #98A2B3;
    font-size: 12pt;
    padding: 0 18px 11px 18px;
}
QLabel#navGroup {
    color: #98A2B3;
    padding: 11px 18px 5px 18px;
    font-size: 12pt;
    font-weight: 700;
}
QPushButton#navButton {
    min-height: 39px;
    color: #E4E7EC;
    text-align: left;
    border: 0;
    border-radius: 0;
    padding: 0 18px;
    background: transparent;
    font-size: 13.25pt;
}
QPushButton#navButton:hover { background: #263548; color: #FFFFFF; }
QPushButton#navButton:checked {
    background: #155EEF;
    color: #FFFFFF;
    border-left: 4px solid #FFFFFF;
    padding-left: 14px;
    font-weight: 700;
}
QLabel#connectionStatus {
    color: #98A2B3;
    padding: 11px 18px 14px 18px;
    line-height: 1.35;
    font-size: 12pt;
}
QStatusBar {
    min-height: 30px;
    background: #FFFFFF;
    color: #667085;
    border-top: 1px solid #C7CDD6;
    font-size: 12pt;
}


QWidget#pageHeader { background: transparent; }
QLabel#pageTitle {
    color: #101828;
    font-size: 20pt;
    font-weight: 700;
}
QLabel#pageSubtitle {
    color: #475467;
    font-size: 12pt;
    line-height: 1.35;
}
QLabel#sectionTitle {
    color: #101828;
    font-size: 14.5pt;
    font-weight: 700;
    padding-top: 1px;
}
QLabel#mutedText, QLabel#metricTitle, QLabel#metricUnit { color: #667085; }
QLabel#helperText { color: #667085; font-size: 12pt; }


QFrame#summaryStrip {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 8px;
}
QLabel#summaryKey { color: #667085; font-size: 12pt; }
QLabel#summaryValue { color: #101828; font-weight: 700; font-size: 13.25pt; }
QFrame#summaryDivider { color: #98A2B3; }


QFrame#card, QFrame#resultPane, QFrame#toolbarCard {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 9px;
}
QFrame#card:hover { border-color: #667085; }
QLabel#cardTitle, QLabel#resultTitle {
    color: #101828;
    font-size: 13.25pt;
    font-weight: 700;
}
QLabel#metricValue {
    font-size: 19pt;
    font-weight: 700;
    color: #155EEF;
}
QLabel#metricUnit { padding-top: 5px; font-size: 12pt; }


QPushButton {
    min-height: 38px;
    border-radius: 6px;
    padding: 0 12px;
    font-size: 12pt;
}
QPushButton[kind="primary"] {
    background: #155EEF;
    color: #FFFFFF;
    border: 1px solid #155EEF;
    font-weight: 700;
    text-align: center;
    padding: 0 16px;
    min-height: 34px;
}
QPushButton[kind="primary"]:hover { background: #004EEB; }
QPushButton[kind="primary"]:pressed { background: #0040C1; }
QPushButton[kind="secondary"] {
    background: #FFFFFF;
    color: #155EEF;
    border: 1px solid #667085;
}
QPushButton[kind="secondary"]:hover { background: #F7F8FA; border-color: #155EEF; }
QPushButton[kind="secondary"]:checked {
    background: #155EEF;
    color: #FFFFFF;
    border: 1px solid #155EEF;
    font-weight: 700;
}
QPushButton[kind="secondary"]:checked:hover { background: #004EEB; border-color: #004EEB; }
QPushButton:disabled { color: #8A94A3; background: #E6EAF0; border-color: #C7CDD6; }
QToolButton {
    min-height: 31px;
    border: none;
    color: #2a3b49;
    font-weight: 700;
    text-align: left;
}


QLabel[tone="success"] { background:#E8F5EC; color:#166534; border-radius:11px; padding:4px 9px; font-size:12pt; }
QLabel[tone="warning"] { background:#FFF4E5; color:#9A4A00; border-radius:11px; padding:4px 9px; font-size:12pt; }
QLabel[tone="info"] { background:#E8F0FF; color:#1D4ED8; border-radius:11px; padding:4px 9px; font-size:12pt; }
QLabel[tone="danger"] { background:#FDECEC; color:#B91C1C; border-radius:11px; padding:4px 9px; font-size:12pt; }


QGroupBox {
    font-size: 13.25pt;
    font-weight: 700;
    border: 1px solid #98A2B3;
    border-radius: 8px;
    margin-top: 12px;
    padding: 13px 10px 9px 10px;
    background: #FFFFFF;
}
QGroupBox::title { subcontrol-origin: margin; left: 11px; padding: 0 6px; color: #101828; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 6px;
    min-height: 36px;
    padding: 1px 7px;
    selection-background-color: #155EEF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #155EEF; }
QComboBox::drop-down { width: 26px; border: 0; }
QRadioButton, QCheckBox { min-height: 30px; spacing: 6px; }
QFormLayout QLabel { color: #344054; }
/* 单位小方块：跟在数值输入框右边的 "nm" / "mm" 之类。
   生成处：frontend_pyside/modules/shared.py 的 _spin_unit_row()。

   高度必须和它左边的输入框严格对齐，否则一行里两个框一高一矮。
   Qt QSS 走的是 CSS2 盒模型：min/max-height 管的是**内容区**高度，
   最终控件高 = 内容高 + 上下 padding + 上下 border。所以：

     输入框（见下方 ObjectInspector 那条） 28 + 1+1 + 1+1 = 32px
     单位框（本条）                        28 + 1+1 + 1+1 = 32px

   两处的 28 必须同时改，只改一处就会重新错位。 */
QLabel#UnitLabel {
    min-height: 28px;
    max-height: 28px;
    padding: 1px 7px;
    background: #F8FAFC;
    border: 1px solid #C7CDD6;
    border-radius: 6px;
    color: #475467;
}


QTabWidget::pane {
    border: 1px solid #98A2B3;
    background: #FFFFFF;
    border-radius: 7px;
    top: -1px;
}
QTabBar::tab {
    min-height: 39px;
    background: #E6EAF0;
    color: #475467;
    padding: 0 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 12pt;
}
QTabBar::tab:hover { background: #F7F8FA; }
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #155EEF;
    border-top: 3px solid #155EEF;
    font-weight: 700;
}


QTableWidget, QTreeWidget, QListWidget {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 7px;
    alternate-background-color: #F7F8FA;
    gridline-color: #C7CDD6;
    outline: none;
}
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    min-height: 36px;
    padding: 3px 6px;
}
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background: #155EEF;
    color: #FFFFFF;
}
QHeaderView::section {
    background: #E6EAF0;
    color: #344054;
    border: 0;
    border-right: 1px solid #C7CDD6;
    border-bottom: 1px solid #C7CDD6;
    min-height: 39px;
    padding: 4px 7px;
    font-weight: 700;
}


QSplitter::handle { background: #C7CDD6; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:hover { background: #667085; }
QScrollBar:vertical { width: 12px; background: #E6EAF0; margin: 0; }
QScrollBar::handle:vertical { background: #98A2B3; min-height: 36px; border-radius: 6px; }
QScrollBar:horizontal { height: 12px; background: #E6EAF0; }
QScrollBar::handle:horizontal { background: #98A2B3; min-width: 32px; border-radius: 6px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QFrame#resultToolbar { background: #F7F8FA; border: 1px solid #98A2B3; border-radius: 7px; }
QLabel#emptyHint { color: #667085; font-size: 13.25pt; }


QWidget#navPanel {
    background: #17202D;
    border-right: 1px solid #0F1722;
}
QWidget#brandRow {
    background: #17202D;
    border-bottom: 1px solid #344054;
}
QLabel#brand {
    color: #FFFFFF;
    font-size: 14.5pt;
    font-weight: 700;
    padding: 0;
}
QLabel#brandSubtitle {
    color: #98A2B3;
    font-size: 12pt;
    padding: 0;
}
QToolButton#sidebarToggle {
    min-width: 32px;
    max-width: 32px;
    min-height: 36px;
    max-height: 32px;
    border-radius: 6px;
    background: #344054;
    padding: 0;
}
QToolButton#sidebarToggle:hover { background: #475467; }
QLabel#navGroup {
    color: #98A2B3;
    padding: 11px 16px 5px 16px;
    font-size: 12pt;
    font-weight: 700;
}
QToolButton#navButton {
    min-height: 45px;
    color: #E4E7EC;
    text-align: left;
    border: 0;
    border-left: 4px solid transparent;
    border-radius: 0;
    padding: 0 14px;
    background: transparent;
    font-size: 13.25pt;
    font-weight: 500;
}
QToolButton#navButton:hover {
