}

QSplitter::handle {
    background: #C7CDD6;
}
QSplitter::handle:hover {
    background: #667085;
}
QSplitter::handle:horizontal {
    width: 5px;
}
QSplitter::handle:vertical {
    height: 5px;
}
QTabWidget::pane {
    border: 1px solid #98A2B3;
    background: #FFFFFF;
}
QTabBar::tab {
    min-height: 30px;
    padding: 4px 11px;
}
QTableView::item, QTableWidget::item {
    min-height: 28px;
    padding: 3px 6px;
}
QHeaderView::section {
    min-height: 31px;
    padding: 4px 6px;
}


QLabel#datasetCompactSummary,
QLabel#taskCompactSummary {
    min-height: 28px;
    padding: 5px 10px;
