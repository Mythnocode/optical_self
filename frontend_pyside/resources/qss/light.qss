}


QWidget#shapLinkagePanel QLabel {
    font-size: 13.25pt;
}
QWidget#shapLinkagePanel QLabel#cardTitle,
QWidget#shapLinkagePanel QLabel#sectionTitle {
    font-size: 12.5pt;
    font-weight: 700;
}
QWidget#shapLinkagePanel QLabel#mutedText,
QWidget#shapLinkagePanel QLabel#helperText {
    font-size: 12pt;
}
QListWidget#weightedFeatureList {
    font-size: 13.25pt;
}
QListWidget#weightedFeatureList::item {
    min-height: 38px;
    padding: 4px 8px;
    border-bottom: 1px solid #E6EAF0;
}



QFrame#sideDetailDrawer {
