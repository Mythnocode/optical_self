}
QWidget#homePlatformWorkflowImage {
    background: #FFFFFF;
    border: 1px solid #B9D4FF;
    border-radius: 10px;
}
QLabel#articleBodyText {
    color: #344054;
    font-size: 13.25pt;
    line-height: 1.45;
}
QLabel#articleSubheading {
    color: #344054;
    font-size: 13.25pt;
    font-weight: 700;
    padding-top: 5px;
}
QLabel#articleStatus {
    color: #155EEF;
    background: #eaf5fc;
    border: 1px solid #c8e2f3;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 12pt;
