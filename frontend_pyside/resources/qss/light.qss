    font-weight: 700;
    padding: 4px 2px;
}
QToolButton#sideDetailDrawerToggle:hover {
    color: #155EEF;
    background: #F7F8FA;
}
QTabWidget#sideDetailTabs::pane {
    border: 0;
    background: #FFFFFF;
}
QSplitter#simulationResultSplitter::handle:horizontal,
QSplitter#optimizationScanSplitter::handle:horizontal,
QSplitter#machineLearningDatasetSplitter::handle:horizontal,
QSplitter#machineLearningTrainingSplitter::handle:horizontal,
QSplitter#machineLearningModelSplitter::handle:horizontal {
    width: 7px;
    background: #C7CDD6;
}
QSplitter#simulationResultSplitter::handle:horizontal:hover,
QSplitter#optimizationScanSplitter::handle:horizontal:hover,
QSplitter#machineLearningDatasetSplitter::handle:horizontal:hover,
QSplitter#machineLearningTrainingSplitter::handle:horizontal:hover,
QSplitter#machineLearningModelSplitter::handle:horizontal:hover {
    background: #667085;
}
QLabel#compactAssetText {
    color: #344054;
    font-size: 12pt;
    line-height: 1.35;
    padding: 3px 1px;
}
QFrame#resultPane {
    min-width: 0;
}


QPushButton#workflowStepButton {
    min-height: 36px;
    padding: 4px 14px;
    color: #38566a;
    background: #E6EAF0;
    border: 1px solid #98A2B3;
    border-radius: 7px;
    font-size: 13.25pt;
    font-weight: 600;
}
QPushButton#workflowStepButton:hover {
    color: #155EEF;
    background: #f7fbfe;
    border-color: #9bc4df;
}
QPushButton#workflowStepButton:checked {
    color: #FFFFFF;
    background: #155EEF;
    border-color: #155EEF;
    font-weight: 700;
}
QTableWidget#quickLensTable {
    background: #FFFFFF;
    gridline-color: #e3e9ee;
    font-size: 12pt;
}
QFrame#quickSurfacePanel,
QFrame#lensWindowToolbar,
QFrame#lensWindowFooter {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 7px;
}
QTreeWidget#lensElementTree {
    background: #FFFFFF;
    border: 0;
    font-size: 12pt;
}
QTreeWidget#lensElementTree::item {
    min-height: 30px;
    padding: 3px 5px;
}
QTreeWidget#lensElementTree::item:selected {
    color: #123f5d;
    background: #dceefa;
    border-left: 4px solid #155EEF;
}
QFrame#livePreviewToolbar {
    min-height: 38px;
}
QLabel#previewStatus {
    min-height: 0;
    padding: 0;
}


QToolButton#expandableSectionHeader[variant="primary"] {
    min-height: 40px;
    color: #FFFFFF;
    background: #155EEF;
    border: 1px solid #145d96;
    border-radius: 7px;
    padding: 4px 12px;
    font-size: 13.25pt;
    font-weight: 700;
    text-align: left;
}
QToolButton#expandableSectionHeader[variant="primary"]:hover {
    color: #FFFFFF;
    background: #2379b6;
    border-color: #0f568e;
}
QToolButton#expandableSectionHeader[variant="primary"]:checked {
    color: #FFFFFF;
    background: #0f5f9d;
    border-color: #0b4e82;
}



QWidget { color: #101828; }
QMainWindow, QWidget#centralRoot, QStackedWidget#featureStack,
QScrollArea#pageScroll > QWidget > QWidget { background: #EEF1F5; }
QWidget#navPanel, QWidget#brandRow { background: #17202D; border-color: #0F1722; }
QLabel#brand { color: #FFFFFF; }
QLabel#brandSubtitle, QLabel#navGroup, QLabel#connectionStatus { color: #98A2B3; }
QToolButton#navButton { color: #E4E7EC; border-left: 4px solid transparent; }
QToolButton#navButton:hover { background: #263548; color: #FFFFFF; }
QToolButton#navButton:checked { background: #155EEF; color: #FFFFFF; border-left-color: #FFFFFF; }
QToolButton#sidebarToggle { background: #344054; border: 1px solid #667085; }
QToolButton#sidebarToggle:hover { background: #475467; }

QLabel#pageTitle, QLabel#sectionTitle, QLabel#cardTitle, QLabel#resultTitle,
QLabel#lensEditorTitle { color: #101828; }
QLabel#pageSubtitle, QLabel#mutedText, QLabel#metricTitle, QLabel#metricUnit,
QLabel#helperText, QLabel#compactContext, QLabel#inlineMetricTitle,
QLabel#inlineMetricUnit, QLabel#inlineMetricNote { color: #667085; }

QFrame#card, QFrame#resultPane, QFrame#toolbarCard, QFrame#summaryStrip,
QFrame#workspaceSurface, QFrame#inlineMetric, QFrame#metricSummaryBar,
QFrame#simulationResultSummary, QFrame#resultValidityBar,
QFrame#simulationModeToolbar, QFrame#livePreviewToolbar, QFrame#propertyDrawer,
QFrame#sectionNavigator, QFrame#expandableSection {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
}
QFrame#subtlePanel, QFrame#resultToolbar, QFrame#raySectionControls,
QWidget#sectionNavigatorHeader, QToolButton#expandableSectionHeader {
    background: #F7F8FA;
    border-color: #C7CDD6;
}

QPushButton[kind="primary"], QToolButton#simulationModeButton:checked,
QToolButton#previewToolButton:checked, QToolButton#expandableSectionHeader:checked {
    background: #155EEF; color: #FFFFFF; border-color: #155EEF;
}
QPushButton[kind="primary"]:hover { background: #004EEB; border-color: #004EEB; }
QPushButton[kind="primary"]:pressed { background: #0040C1; border-color: #0040C1; }
QPushButton[kind="secondary"], QToolButton#simulationModeButton,
QToolButton#previewToolButton, QToolButton#editorActionButton {
    background: #FFFFFF; color: #0A327A; border: 1px solid #667085;
}
QPushButton[kind="secondary"]:hover, QToolButton#simulationModeButton:hover,
QToolButton#previewToolButton:hover, QToolButton#editorActionButton:hover {
    background: #F7F8FA; color: #155EEF; border-color: #155EEF;
}
QPushButton[kind="secondary"]:checked { background: #155EEF; color: #FFFFFF; border-color: #155EEF; }
QPushButton:disabled, QToolButton:disabled { color: #8A94A3; background: #E6EAF0; border-color: #C7CDD6; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    color: #101828; background: #FFFFFF; border: 1px solid #667085;
    selection-color: #FFFFFF; selection-background-color: #155EEF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border: 2px solid #155EEF; }
QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only { background: #F7F8FA; color: #344054; }
QFormLayout QLabel, QLabel#propertyFieldLabel { color: #344054; }

QTabWidget::pane { background: #FFFFFF; border: 1px solid #98A2B3; }
QTabBar::tab { background: #E6EAF0; color: #344054; }
QTabBar::tab:hover { background: #C7CDD6; color: #101828; }
QTabBar::tab:selected { background: #FFFFFF; color: #0A327A; border-top: 3px solid #155EEF; }

QTableWidget, QTreeWidget, QListWidget { background: #FFFFFF; border: 1px solid #98A2B3; alternate-background-color: #F7F8FA; }
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected,
QListWidget#sectionList::item:selected { background: #155EEF; color: #FFFFFF; }
QTableWidget::item:hover, QTreeWidget::item:hover, QListWidget::item:hover { background: #D6E4FF; color: #101828; }
QHeaderView::section { background: #E6EAF0; color: #101828; border-color: #98A2B3; }

QLabel[tone="success"] { background: #DDF5E8; color: #087A41; border: 1px solid #087A41; }
QLabel[tone="warning"] { background: #FFF0D5; color: #A65300; border: 1px solid #A65300; }
QLabel[tone="danger"] { background: #FDE3E2; color: #C5221F; border: 1px solid #C5221F; }
QLabel[tone="info"] { background: #D6E4FF; color: #0A327A; border: 1px solid #155EEF; }
QLabel#metricValue, QLabel#inlineMetricValue, QLabel#largeResultValue { color: #155EEF; }
QLabel#errorSummary { color: #C5221F; }
QPlainTextEdit#errorDetails { background: #FFFFFF; border: 1px solid #C5221F; color: #101828; }

QScrollBar:vertical, QScrollBar:horizontal { background: #E6EAF0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #667085; }
QSplitter::handle { background: #C7CDD6; }
QSplitter::handle:hover { background: #667085; }


QFrame#trainingConfigCard {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 9px;
}
QFrame#trainingConfigCard QLabel#cardTitle {
    color: #101828;
    font-size: 15pt;
    font-weight: 700;
    padding: 0 0 5px 0;
}
QFrame#trainingConfigCard QComboBox,
QFrame#trainingConfigCard QSpinBox,
QFrame#trainingConfigCard QDoubleSpinBox {
    min-height: 38px;
}
QGroupBox#measurementResultCard {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 700;
}
QGroupBox#measurementResultCard::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}
QLabel#measurementMetric {
    color: #155EEF;
    font-weight: 700;
}

QFrame#inlineMetric { background:#FFFFFF; border:1px solid #C7CDD6; border-radius:8px; }
QLabel#inlineMetricTitle { color:#475467; font-size:12pt; }
QLabel#inlineMetricValue { color:#0A327A; font-size:15pt; font-weight:700; }
QLabel#inlineMetricUnit { color:#475467; font-size:12pt; }
QLabel#inlineMetricNote { color:#475467; font-size:12pt; }
QProgressBar { min-height:32px; border:1px solid #98A2B3; border-radius:7px; background:#FFFFFF; text-align:center; font-size:12pt; font-weight:700; color:#101828; }
QProgressBar::chunk { background:#1D4ED8; border-radius:6px; }
QLabel[statusTone="current"] { color:#166534; font-weight:700; }
QLabel[statusTone="warning"] { color:#9A4A00; font-weight:700; }
QLabel[statusTone="danger"] { color:#B91C1C; font-weight:700; }
QLabel[statusTone="muted"] { color:#667085; font-weight:700; }

/* 录屏/投屏可读性：状态标签不低于普通正文的次级字号。 */
QLabel[tone="success"], QLabel[tone="warning"], QLabel[tone="danger"], QLabel[tone="info"] {
    font-size: 12pt;
    font-weight: 700;
}

/* AI research navigation: temporary highlight after one-click contextual navigation. */
QWidget[assistantHighlight="true"] {
    border: 2px solid #F79009;
    border-radius: 7px;
}

/* -------------------------------------------------------------------------
   2026-08-17 紧凑工程工作台壳层
   高对比、较大字号；永久区域只承担导航/文档/状态，不承载第二主内容。
   ------------------------------------------------------------------------- */
QFrame#compactTopBar {
    background: #FFFFFF;
    border-bottom: 1px solid #98A2B3;
    min-height: 42px;
    max-height: 42px;
}
QToolButton#shellIconButton, QToolButton#shellMenuButton,
QToolButton#footerActionButton, QToolButton#drawerCloseButton,
QToolButton#railHomeButton, QToolButton#railCategoryButton {
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 6px;
    min-width: 30px;
    min-height: 30px;
}
QToolButton#shellIconButton:hover, QToolButton#shellMenuButton:hover,
QToolButton#footerActionButton:hover, QToolButton#drawerCloseButton:hover {
    background: #E6EAF0;
    border-color: #98A2B3;
}
QFrame#compactNavRail {
    background: #17202D;
    border-right: 1px solid #0F1722;
}
QToolButton#railHomeButton, QToolButton#railCategoryButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    border-radius: 8px;
}
QToolButton#railHomeButton:hover, QToolButton#railCategoryButton:hover {
    background: #263548;
    border-color: #667085;
}
QToolButton#railCategoryButton:checked {
    background: #155EEF;
    border-color: #FFFFFF;
}
QFrame#railSeparator {
    color: #667085;
    background: #667085;
    min-height: 1px;
    max-height: 1px;
    margin: 2px 5px 4px 5px;
}
QFrame#compactToolDrawer {
    background: #FFFFFF;
    border-right: 1px solid #667085;
}
QLabel#drawerTitle {
    color: #101828;
    font-size: 16pt;
    font-weight: 800;
}
QLabel#drawerGroupTitle {
    color: #344054;
    font-size: 12.5pt;
    font-weight: 700;
    padding-top: 3px;
}
QPushButton#drawerActionButton {
    background: #FFFFFF;
    color: #101828;
    border: 1px solid #98A2B3;
    border-radius: 8px;
    padding: 8px 10px;
    text-align: left;
    font-size: 12.75pt;
    font-weight: 650;
}
QPushButton#drawerActionButton:hover {
    background: #D6E4FF;
    color: #0A327A;
    border-color: #155EEF;
}
QPushButton#drawerActionButton:pressed {
    background: #B7CEFF;
    border-color: #0040C1;
}
QTabBar#documentTabBar {
    background: #FFFFFF;
}
QTabBar#documentTabBar::tab {
    background: #F7F8FA;
    color: #344054;
    border: 1px solid #C7CDD6;
    border-bottom: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    min-width: 104px;
    max-width: 210px;
    min-height: 30px;
    padding: 5px 10px;
    margin-right: 3px;
    font-size: 12.5pt;
    font-weight: 600;
}
QTabBar#documentTabBar::tab:selected {
    background: #FFFFFF;
    color: #0A327A;
    border-color: #667085;
    border-top: 3px solid #155EEF;
    font-weight: 800;
}
QTabBar#documentTabBar::tab:hover:!selected {
    background: #E6EAF0;
    color: #101828;
}
QLabel#compactConnectionStatus {
    color: #344054;
    background: #F7F8FA;
    border: 1px solid #C7CDD6;
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 12.5pt;
    font-weight: 700;
}
QLabel#compactConnectionStatus[tone="success"] { color: #05603A; border-color: #12B76A; background: #DDF5E8; }
QLabel#compactConnectionStatus[tone="warning"] { color: #7A2E0E; border-color: #D97706; background: #FFF0D5; }
QLabel#compactConnectionStatus[tone="danger"] { color: #912018; border-color: #C5221F; background: #FDE3E2; }
QFrame#compactFooter {
    background: #FFFFFF;
    border-top: 1px solid #98A2B3;
    min-height: 34px;
    max-height: 34px;
}
QLabel#footerMetric {
    color: #0A327A;
    font-size: 12.5pt;
    font-weight: 800;
}
QLabel#footerNotice {
    color: #475467;
    font-size: 12.5pt;
    font-weight: 600;
}
QWidget#centralRoot, QStackedWidget#featureStack {
    background: #EEF1F5;
}

/* ===== 分析器关键指标：像成熟光学软件一样把数值归属于当前图，而非新增菜单 ===== */
QFrame#analysisMetricStrip {
    background: #F8FAFC;
    border: 1px solid #98A2B3;
    border-radius: 7px;
}
QLabel#analysisMetricItem {
    color: #101828;
    font-size: 13.5pt;
    font-weight: 650;
    padding: 2px 4px;
}
QToolButton#analysisMetricDetailsButton {
    color: #344054;
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 12.5pt;
    font-weight: 600;
}
QToolButton#analysisMetricDetailsButton:hover,
QToolButton#analysisMetricDetailsButton:checked {
    color: #FFFFFF;
    background: #155EEF;
    border-color: #155EEF;
}
QLabel#analysisMetricDetails {
    color: #344054;
    background: #FFFFFF;
    border-top: 1px solid #D0D5DD;
    padding: 7px 5px 3px 5px;
    font-size: 12.5pt;
    line-height: 1.35;
}

/* 2026-08-17 canvas-first command strip: no permanent feature rail or fake document tabs. */
QToolButton#shellHomeButton {
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px;
    min-width: 32px;
    min-height: 32px;
}
QToolButton#shellHomeButton:hover {
    background: #E6EAF0;
    border-color: #98A2B3;
}
QFrame#shellCommandDivider {
    color: #C7CDD6;
    background: #C7CDD6;
    min-width: 1px;
    max-width: 1px;
    margin: 5px 5px;
}
QToolButton#shellCommandButton {
    background: transparent;
    color: #1D2939;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px 9px;
    min-height: 32px;
    font-size: 12.5pt;
    font-weight: 700;
}
QToolButton#shellCommandButton:hover,
QToolButton#shellCommandButton::menu-button:hover {
    background: #EAF1FF;
    color: #0A327A;
    border-color: #98B8F8;
}
QToolButton#shellCommandButton:pressed {
    background: #D6E4FF;
}
QToolButton#shellCommandButton:checked {
    background: #EAF1FF;
    color: #0A327A;
    border-color: #6F9EF0;
}
QToolButton#shellCommandButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Teaching: experiment-first navigation and compact 3D camera controls. */
QWidget#teachingExperimentNavigation {
    background: transparent;
}
QToolButton#teachingMismatchButton {
    background: #FFFFFF;
    color: #1D2939;
    border: 1px solid #98A2B3;
    border-radius: 7px;
    padding: 6px 13px;
    min-height: 30px;
    font-size: 12.5pt;
    font-weight: 700;
}
QToolButton#teachingMismatchButton:hover,
QToolButton#teachingMismatchButton:pressed {
    background: #EAF1FF;
    color: #0A327A;
    border-color: #6695F5;
}
QToolButton#teachingSecondaryAction {
    background: transparent;
    color: #344054;
    border: 1px solid #98A2B3;
    border-radius: 7px;
    padding: 5px 11px;
    min-height: 30px;
    font-size: 12pt;
    font-weight: 650;
}
QLabel#teachingProcessHint {
    color: #475467;
    font-size: 11.5pt;
    padding: 1px 2px 4px 2px;
}
QFrame#teachingCameraBar {
    background: rgba(248,250,252,238);
    border: 1px solid #98A2B3;
    border-radius: 8px;
}
QToolButton#teachingCameraPresetButton,
QToolButton#teachingCameraDisplayButton {
    background: #FFFFFF;
    color: #1D2939;
    border: 1px solid #B8C0CC;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 26px;
    font-size: 11.5pt;
    font-weight: 650;
}
QToolButton#teachingCameraPresetButton:hover,
QToolButton#teachingCameraDisplayButton:hover {
    background: #EAF1FF;
    color: #0A327A;
    border-color: #6695F5;
}

/* 2026-08-17 floating toolbox: capability catalogue, not a permanent nav rail. */
QToolButton#toolboxFloatingButton {
    background: #FFFFFF;
    color: #0A327A;
    border: 2px solid #155EEF;
    border-radius: 23px;
    font-size: 11.5pt;
    font-weight: 800;
}
QToolButton#toolboxFloatingButton:hover {
    background: #EAF1FF;
    border-color: #0040C1;
}
QToolButton#toolboxFloatingButton:pressed {
    background: #D6E4FF;
}
QLineEdit#toolboxSearch {
    min-height: 32px;
    border: 1px solid #98A2B3;
    border-radius: 7px;
    padding: 4px 8px;
    background: #FFFFFF;
    color: #101828;
    font-size: 11.5pt;
}
QScrollArea#toolboxScroll { background: transparent; border: 0; }
QLabel#drawerCategoryTitle {
    color: #101828;
    font-size: 12.5pt;
    font-weight: 800;
    padding-top: 7px;
    padding-bottom: 2px;
}
QLabel#drawerEmptyText { color: #667085; padding: 12px 4px; }
QPushButton#drawerActionButton {
    min-height: 34px;
    padding: 5px 8px;
    border-radius: 6px;
    font-size: 11.5pt;
}
QLabel#homePlatformTitle {
    color: #102A56;
    font-size: 20pt;
    font-weight: 800;
    padding: 4px 0 8px 0;
}
QTextBrowser#analysisDetailReport {
    background: #FFFFFF;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 12px 16px;
    color: #101828;
    selection-background-color: #B2CCFF;
}

/* 2026-08-17 layout tightening + task feedback */
QPushButton[kind="primary"][taskState="submitted"],
QPushButton[kind="primary"][taskState="running"] {
    background:#155EEF; color:#FFFFFF; border-color:#004EEB;
}
QPushButton[kind="primary"][taskState="success"] {
    background:#15803D; color:#FFFFFF; border-color:#166534;
}
QPushButton[kind="primary"][taskState="error"] {
    background:#B42318; color:#FFFFFF; border-color:#912018;
}
QPushButton[kind="primary"][taskState="pending"] {
    background:#B54708; color:#FFFFFF; border-color:#93370D;
}
QFrame#taskPreviewBanner {
    background:#FFF7E8; border:1px solid #F79009; border-radius:7px;
}
QLabel#taskPreviewTitle { color:#93370D; font-weight:800; }
QLabel#taskPreviewText { color:#7A2E0E; }
QFrame#taskProgressPanel {
    background:#F5F8FF; border:1px solid #84ADFF; border-radius:7px;
}
QLabel#taskProgressTitle { color:#0A327A; font-weight:800; }
QProgressBar#taskProgressBar {
    min-height:24px; max-height:24px; border:1px solid #84ADFF; border-radius:6px;
    background:#FFFFFF; color:#102A56; font-size:11pt; font-weight:700; text-align:center;
}
QProgressBar#taskProgressBar::chunk { background:#155EEF; border-radius:5px; }

/* The toolbox is a compact capability index, not a wall of cards. */
QFrame#compactToolDrawer { border-right:1px solid #98A2B3; }
QPushButton#drawerActionButton {
    min-height:30px; max-height:34px; padding:3px 7px; margin:0;
    border:1px solid transparent; border-radius:5px; background:transparent;
    color:#101828; font-size:11.25pt; font-weight:600; text-align:left;
}
QPushButton#drawerActionButton:hover {
    background:#EAF1FF; border-color:#B2CCFF; color:#0A327A;
}
QPushButton#drawerActionButton:pressed {
    background:#D6E4FF; border-color:#84ADFF;
}
QLabel#drawerCategoryTitle {
    color:#344054; font-size:11.5pt; font-weight:800; padding:5px 2px 1px 2px;
}
QLabel#drawerGroupTitle {
    color:#667085; font-size:10.75pt; font-weight:700; padding:2px 2px 0 2px;
}

QFrame#optimizationTaskHeader {
    background:#FFFFFF; border-bottom:1px solid #D0D5DD;
}
QLabel#optimizationTaskTitle { color:#101828; font-size:16pt; font-weight:800; }
QLabel#optimizationTaskSubtitle { color:#667085; font-size:11.5pt; }
QFrame#optimizationResultHost { background:#FFFFFF; }
QFrame#simulationCompactMetric {
    background:transparent; border:0; border-radius:0;
}
QFrame#simulationCompactMetric QLabel#inlineMetricTitle { color:#475467; font-size:11.25pt; }
QFrame#simulationCompactMetric QLabel#inlineMetricValue { color:#0A327A; font-size:14pt; font-weight:800; }
QFrame#simulationCompactMetric QLabel#inlineMetricUnit { color:#475467; font-size:11pt; }
QFrame#simulationResultSummary {
    background:#FFFFFF; border:1px solid #D0D5DD; border-radius:7px;
}

/* Simulation object/parameter navigator: compact hierarchy, not four giant blue cards. */
QToolButton#expandableSectionHeader[variant="navigation"] {
    min-height: 32px;
    max-height: 34px;
    padding: 2px 8px;
    color: #344054;
    background: #F7F8FA;
    border: 0;
    border-radius: 5px;
    font-size: 12.5pt;
    font-weight: 700;
    text-align: left;
}
QToolButton#expandableSectionHeader[variant="navigation"]:hover {
    color: #0A327A;
    background: #EAF2FF;
}
QToolButton#expandableSectionHeader[variant="navigation"]:checked {
    color: #0A327A;
    background: #DDEAFF;
    border-left: 3px solid #155EEF;
}
QScrollArea#simulationParameterAccordion QFrame#expandableSection {
    border-radius: 5px;
    border-color: #C7CDD6;
}
QScrollArea#simulationParameterAccordion QWidget#expandableSectionContent {
    background: #FFFFFF;
}
QScrollArea#simulationParameterAccordion QFrame#card {
    border-color: #D0D5DD;
    border-radius: 6px;
}
QScrollArea#simulationParameterAccordion QLabel#cardTitle {
    font-size: 12.5pt;
}
QScrollArea#simulationParameterAccordion QDoubleSpinBox,
QScrollArea#simulationParameterAccordion QSpinBox,
QScrollArea#simulationParameterAccordion QComboBox,
QScrollArea#simulationParameterAccordion QLineEdit,
QScrollArea#simulationParameterAccordion QPushButton[kind="secondary"] {
    min-height: 30px;
    max-height: 34px;
}
QToolButton#teachingMismatchButton:checked {
    background: #DDEAFF;
    color: #0A327A;
    border-color: #155EEF;
}

/* Compact optical-object rows: narrow sidebars must not contain wide Surface tables. */
QPushButton#lensObjectButton {
    text-align: left;
    padding: 5px 10px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #102A56;
}
QPushButton#lensObjectButton:hover {
    background: #EEF4FF;
    border-color: #B8CCF3;
}
QPushButton#lensObjectButton:checked {
    background: #DCE9FF;
    border-color: #8FB3F4;
    color: #073A89;
}
QToolButton#compactTextTool {
    border: 0;
    background: transparent;
    color: #174EA6;
    padding: 3px 4px;
}
QToolButton#compactTextTool:hover {
    color: #0B63D9;
    text-decoration: underline;
}

/* ===== Refactored workbench shell =====
   The shell owns navigation; documents own plots and metrics.  No persistent
   full-width footer is needed. */
QFrame#PrimaryBar {
    background: #FFFFFF;
    border-bottom: 1px solid #C7CDD6;
}
/* 一级栏（首页/仿真/教学/模型/优化/解释）、一级栏右侧的动作按钮
   （保存/计算/设置）、教学栏按钮：都是纯文字，保持紧凑高度。
   二级功能栏**不在这组里**，它单独一条，见下面。 */
QToolButton#PrimaryModuleButton,
QToolButton#PrimaryActionButton,
QToolButton#TeachingToolButton {
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #344054;
    font-weight: 650;
}
/* 二级功能栏按钮：上图下字（图标在上、文字在下）。
   图标由 Python 侧设置（workbench_shell 的 _secondary_icon），
   QSS 只管高度和配色。
   高度 = 图标 22 + 行距若干 + 文字一行 ≈ 54，还要留出 padding，
   所以 min-height 给小了文字会被压掉。
   注意：这条是独立规则，不要并回上面那一组，否则一级栏会被一起撑高。 */
QToolButton#SecondaryFunctionButton {
    min-height: 54px;
    min-width: 72px;
    padding: 5px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #344054;
    font-weight: 650;
}
QToolButton#PrimaryActionButton {
    padding: 4px 6px;
    min-width: 40px;
    min-height: 40px;
}
QToolButton#DocumentPinButton {
    border: 0;
    background: transparent;
    padding: 2px;
    border-radius: 4px;
}
QToolButton#DocumentPinButton:checked {
    color: #0A327A;
    background: #DCE9FF;
}
QToolButton#PrimaryModuleButton:hover,
QToolButton#PrimaryActionButton:hover,
QToolButton#SecondaryFunctionButton:hover,
QToolButton#TeachingToolButton:hover {
    background: #EEF4FF;
    border-color: #B8CCF3;
    color: #0A327A;
}
QToolButton#PrimaryModuleButton:checked,
QToolButton#SecondaryFunctionButton:checked {
    background: #DCE9FF;
    border-color: #8FB3F4;
    color: #073A89;
}
QToolButton#TeachingToolButton:checked,
QToolButton#RailCategoryButton:checked {
    background: #155EEF;
    border-color: #0B4EAE;
    color: #FFFFFF;
    font-weight: 800;
}
QToolButton#RailCategoryButton {
    min-height: 30px;
    padding: 4px 9px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #344054;
    font-weight: 700;
}
QToolButton#RailCategoryButton:hover {
    background: #EEF4FF;
    border-color: #B8CCF3;
    color: #0A327A;
}
QFrame#SecondaryBar,
QFrame#TeachingToolbar {
    background: #F8FAFC;
    border-bottom: 1px solid #D0D5DD;
}
QFrame#ObjectRail {
    background: #F8FAFC;
    border-right: 1px solid #D0D5DD;
}
QFrame#AccordionSection {
    background: #FFFFFF;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
}
QToolButton#AccordionHeader {
    min-height: 34px;
    padding: 4px 8px;
    border: none;
    /* 圆角很重要：展开态是一整块实心色，不切圆角会变成一条顶到边的方块，
       看起来像被右侧滚动条切掉了。 */
    border-radius: 6px;
    background: #F8FAFC;
    color: #101828;
    font-weight: 700;
    text-align: left;
}
/* 悬停但未展开：只提亮一点，不要和展开态撞色 */
QToolButton#AccordionHeader:hover {
    background: #EEF4FF;
    color: #0A327A;
}
/* 展开态：实心主蓝 + 白字，与首页「仿真」栏标题头（WorkflowSectionHeader）同一套观感 */
QToolButton#AccordionHeader:checked {
    background: #155EEF;
    color: #FFFFFF;
    font-weight: 800;
}
/* 展开态悬停：再深一档，避免和上面的蓝色一样导致点不动 */
QToolButton#AccordionHeader:checked:hover {
    background: #004EEB;
    color: #FFFFFF;
}
QFrame#ObjectInspector {
    background: transparent;
    border: none;
}
QFrame#FieldGroup {
    background: #F8FAFC;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
}
QLabel#FieldGroupTitle {
    color: #344054;
    font-size: 10.5pt;
    font-weight: 700;
}
QFrame#ObjectInspector QDoubleSpinBox,
QFrame#ObjectInspector QSpinBox,
QFrame#ObjectInspector QComboBox,
QFrame#ObjectInspector QLineEdit,
QDialog#EngineeringDialog QDoubleSpinBox,
QDialog#EngineeringDialog QSpinBox,
QDialog#EngineeringDialog QComboBox,
QDialog#EngineeringDialog QLineEdit {
    min-height: 26px;
    max-height: 28px;
    padding: 1px 8px;
    border-radius: 5px;
}
QFrame#ObjectInspector QDoubleSpinBox,
QFrame#ObjectInspector QSpinBox,
QDialog#EngineeringDialog QDoubleSpinBox,
QDialog#EngineeringDialog QSpinBox {
    padding-right: 8px;
}
QFrame#ObjectInspector QComboBox::drop-down,
QDialog#EngineeringDialog QComboBox::drop-down {
    width: 18px;
}
QLabel#RailTitle,
QLabel#SectionTitle {
    color: #101828;
    font-size: 13.5pt;
    font-weight: 750;
}
QListWidget#ObjectList {
    background: #FFFFFF;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
    padding: 3px;
}
QListWidget#ObjectList::item {
    min-height: 30px;
    padding: 4px 7px;
    border-radius: 5px;
}
QListWidget#ObjectList::item:hover { background: #EEF4FF; }
QListWidget#ObjectList::item:selected { background: #DCE9FF; color: #073A89; }
QFrame#DocumentWorkspace { background: #EEF1F5; }
QToolButton#DocumentSplitButton {
    min-height: 28px;
    padding: 3px 10px;
    border: 1px solid #B8CCF3;
    border-radius: 5px;
    background: #FFFFFF;
    color: #0A327A;
    font-weight: 700;
}
QToolButton#DocumentSplitButton:hover { background: #EEF4FF; }
QTabWidget#DocumentPane::pane {
    background: #FFFFFF;
    border: 1px solid #C7CDD6;
    border-radius: 6px;
}
QTabWidget#DocumentPane QTabBar::tab {
    min-width: 100px;
    padding: 7px 12px;
    background: #E6EAF0;
    color: #475467;
    border: 1px solid #C7CDD6;
    border-bottom: 0;
}
QTabWidget#DocumentPane QTabBar::tab:selected {
    background: #FFFFFF;
    color: #073A89;
    font-weight: 700;
}
QLabel#DocumentTitle,
QLabel#HomeTitle {
    color: #155EEF;
    font-size: 24pt;
    font-weight: 800;
    padding: 0 6px;
}
QLabel#DocumentSubtitle,
QLabel#HelperText,
QLabel#TeachingStatus {
    color: #667085;
}
QWidget#TeachingAnalysisVisual {
    background: #101828;
    border: 1px solid #344054;
    border-radius: 8px;
}
QLabel#TeachingAnalysisSummary {
    color: #047857;
    background: #ECFDF3;
    border: 1px solid #6EE7B7;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14pt;
    font-weight: 800;
}
QFrame#TeachingQuickActions {
    background: rgba(255, 255, 255, 235);
    border: 1px solid #8FB3F4;
    border-radius: 8px;
}
QToolButton#TeachingQuickAction {
    min-width: 60px;
    min-height: 36px;
    padding: 5px 8px;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
    background: #FFFFFF;
    color: #1D2939;
    font-weight: 700;
}
QToolButton#TeachingQuickAction:hover { background: #EEF4FF; border-color: #8FB3F4; }
QToolButton#TeachingQuickAction:disabled { background: #F2F4F7; border-color: #EAECF0; color: #98A2B3; }
QLabel#ExplainFormulaCard {
    background: #F8FBFF;
    border: 1px solid #B8CCF3;
    border-radius: 8px;
    padding: 8px;
    color: #344054;
}
QPushButton#teachingV2PrimaryButton {
    background: #155EEF;
    color: #FFFFFF;
    border: 1px solid #155EEF;
    border-radius: 6px;
    font-size: 12pt;
    font-weight: 800;
    padding: 7px 16px;
}
QPushButton#teachingV2PrimaryButton:hover { background: #004EEB; }
QPushButton#teachingV2PrimaryButton:disabled { background: #84ADFF; border-color: #84ADFF; }
QLabel#DocumentMetric {
    color: #0A327A;
    background: #EEF4FF;
    border: 1px solid #B8CCF3;
    border-radius: 6px;
    padding: 7px 9px;
    font-weight: 700;
}
QLabel#ExplanationPlotPlaceholder {
    background: #F8FAFC;
    border: 1px dashed #98A2B3;
    border-radius: 6px;
    color: #667085;
}
QLabel#coup{
    color: #FFFFFF;
    background: #f59e0b;
    border: 2px solid #CBD5E1;
    border-radius: 10px;
    padding: 4px 7px;
    font-weight: 700;
}
QLabel#ResultSource,
QLabel#TeachingResultSource {
    color: #05603A;
    background: #DDF5E8;
    border: 1px solid #86EFAC;
    border-radius: 5px;
    padding: 4px 7px;
    font-weight: 700;
}
QLabel#ResultSource[stale="true"] {
    color: #7A2E0E;
    background: #FFF0D5;
    border-color: #F2B84B;
}
QLabel#TeachingResultSource {
    color: #7A2E0E;
    background: #FFF0D5;
    border-color: #F2B84B;
}
/* ===== 首页（工作流总览页）=====
   实现代码：frontend_pyside/modules/home/shell.py
   页面结构：WorkflowHome > WorkflowCanvas > 五栏 WorkflowSection > 卡片 WorkflowNode

   这一段的每条规则都靠 objectName 命中 Python 里 setObjectName(...) 设下的名字，
   所以在 Python 里改一个 objectName，这里对应的样式就会失效（不会报错，只是变回
    Qt 默认外观）。改配色主要就改这一段，不需要动 Python。

   主色板：#155EEF 主蓝 / #8FB3F4 浅蓝描边 / #B8CCF3 更浅的描边
           #EEF4FF #F7FAFF #F8FBFF #DCE9FF 由浅到深的蓝底
           #0A327A 深蓝标题字 / #102A56 正文深蓝 / #475467 #667085 灰字 */

/* --- 卡片：首页最小的工作流节点，点一下跳一个页面 ----------------------------
   Python: WorkflowNodeButton（QPushButton 子类，objectName="WorkflowNode"）
   这是 QPushButton 而不是自绘控件，四个状态伪类必须都写全，否则键盘 Tab 选中
   和按下时会出现 Qt 默认外观，跟整体风格对不上。 */
QPushButton#WorkflowNode {
    min-width: 118px;
    min-height: 62px;
    background: #FFFFFF;
    border: 2px solid #B8CCF3;
    border-radius: 12px;
    color: #102A56;
    font-weight: 700;
    padding: 4px;
    text-align: left;
}
/* 悬停：底色转极浅蓝、描边转主蓝，表示「可点」 */
QPushButton#WorkflowNode:hover {
    background: #F7FAFF;
    border-color: #155EEF;
}
/* 键盘焦点：比悬停更强的描边，保证纯键盘操作时能看清当前停在哪张卡片 */
QPushButton#WorkflowNode:focus {
    background: #F7FAFF;
    border: 2px solid #155EEF;
}
/* 按下：底色明显变深，给一个确定的点击反馈 */
QPushButton#WorkflowNode:pressed {
    background: #DCE9FF;
    border-color: #0B4EAE;
}
/* 禁用态：整张卡片转灰，用于将来按权限/前置条件灰掉某个入口 */
QPushButton#WorkflowNode:disabled {
    background: #F2F4F7;
    border-color: #D0D5DD;
}

/* 按卡片类型单独调样式。
   属性 workflowKind 来自 Python 的 setProperty("workflowKind", kind)，
   值就是 NodeSpec.kind。想给某一种卡片换颜色/加粗，就在这里再加一条规则。
   下面这条只是把「教学」这张卡片的描边加重，作为「入门入口」的视觉强调。 */
QPushButton#WorkflowNode[workflowKind="teaching"] {
    border-color: #155EEF;
}

/* --- 顶部动作条按钮：快速开始 / 帮助 ----------------------------------------
   Python: WorkflowHome.__init__ 里 setObjectName("HomeActionButton") 的按钮
   默认无描边无底色，只有悬停/选中时才浮出色块，避免顶部多出一排「按钮感」很重
   的控件抢视觉。 */
QPushButton#HomeActionButton {
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #344054;
    font-weight: 650;
}
QPushButton#HomeActionButton:hover,
QPushButton#HomeActionButton:focus {
    background: #EEF4FF;
    border-color: #B8CCF3;
    color: #0A327A;
}

/* --- 页面底板与主画布 -------------------------------------------------------
   WorkflowHome 是最外层灰底；WorkflowCanvas 是里面那张白色圆角大卡片，
   标题和五栏都装在这张白卡里。 */
QWidget#WorkflowHome {
    background: #F8FAFC;
}
QFrame#WorkflowCanvas {
    background: #FFFFFF;
    border: 1px solid #C7CDD6;
    border-radius: 16px;
}

/* 大标题「光学研究工作流」两侧的装饰横线。
   QFrame 的 HLine 是靠 color 画的（不是 background），所以这里写 color；
   max-height 把这条线压成 2px，否则它会按布局撑高成一条粗条。
   标题本身的字号在下面 QLabel#HomeTitle（和文档标题共用一条规则，搜 HomeTitle）。 */
QFrame#WorkflowTitleRule {
    color: #8FB3F4;
    max-height: 2px;
}

/* --- 卡片内部的三块内容 -----------------------------------------------------
   图标 / 标题 / 副标题都是 QLabel，全部设了 WA_TransparentForMouseEvents，
   鼠标事件会穿透到外层的 WorkflowNode 按钮上。
   border-radius 取控件边长的一半才能得到正圆：图标 36px → 18px。
   若在 Python 里改了 setFixedSize，这里的圆角要跟着改成「边长 ÷ 2」。 */
QLabel#WorkflowNodeIcon {
    background: #EEF4FF;
    border: 2px solid #8FB3F4;
    border-radius: 18px;
}
QLabel#WorkflowNodeTitle {
    color: #0A327A;
    font-size: 13pt;
    font-weight: 800;
}
QLabel#WorkflowNodeSubtitle {
    color: #475467;
    font-size: 10.5pt;
    font-weight: 650;
}

/* 卡片之间的连接箭头。箭头本体由 Python 的 paintEvent 用 QPainter 画，
   这条规则只是把控件本身刷成透明，免得在蓝底栏上露出一个灰方块。 */
QWidget#WorkflowConnector {
    background: transparent;
}

/* --- 五等分栏 ---------------------------------------------------------------
   「水平平分」由 Python 侧的 QHBoxLayout 给每栏 stretch=1 实现，
   QSS 只负责外观，管不了宽度分配。 */
/* 滚动容器与内部承载控件都刷透明，让它们不遮挡上面 WorkflowCanvas 的白底。
   QScrollArea 默认会画自己的方框底，必须显式去掉 frame 与底色。 */
QScrollArea#WorkflowColumns,
QWidget#WorkflowColumnsHost {
    background: transparent;
    border: 0;
}
/* 一栏的整体：浅蓝底 + 蓝色描边 + 大圆角，把「一个业务阶段」圈在一起 */
QFrame#WorkflowSection {
    background: #F8FBFF;
    border: 2px solid #8FB3F4;
    border-radius: 16px;
}
/* 栏标题头：蓝色底的小胶囊，跟栏底色拉开层次 */
QFrame#WorkflowSectionHeader {
    background: #155EEF;
    border: 2px solid #155EEF;
    border-radius: 10px;
}
/* 栏标题的图标：26px 见方 → 圆角 13px 成正圆 */
QLabel#WorkflowSectionIcon {
    border-radius: 13px;
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
}
QLabel#WorkflowSectionTitle {
    color: #FFFFFF;
    font-size: 15pt;
    font-weight: 900;
    letter-spacing: 1px;
}
/* 栏标题下的灰色说明（SectionSpec.subtitle），留空时这一行不显示 */
QLabel#WorkflowSectionHint {
    color: #D6E4FF;
    font-size: 10.5pt;
    font-weight: 650;
}
/* 栏内介绍段落（SectionSpec.intro），显示在标题头和卡片之间，自动换行。
   留空时这个控件根本不会被创建，所以可以放心写样式。
   给它浅底 + 左侧竖线，读起来像「一段说明」而不是另一张卡片。 */
QLabel#WorkflowSectionIntro {
    color: #344054;
    background: #FFFFFF;
    border: 1px solid #D6E4FF;
    border-left: 3px solid #8FB3F4;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13pt;
    font-weight: 800;
}
/* 注意：Qt 的 QSS 支持 letter-spacing，但**不支持 line-height**，
   写了会被静默忽略（不报错、也不生效）。想调段落行距只能在 Python 里给
   QLabel 设富文本样式，本页没这么做。 */

/* ===== 只作用于「仿真」这一栏的样式 =====
   sectionKey 属性来自 Python 的 setProperty("sectionKey", spec.key)
   （见 modules/home/shell.py 的 WorkflowSection.__init__），值是 SectionSpec.key。

   这几条必须写在上面那些通用规则**之后**：QSS 同样遵循「后者覆盖前者」，
   属性选择器并没有更高的优先级，只是更具体而已。

   这里的目标是让「仿真」的栏标题和它下面的节点卡片**明显不是一种东西**：
   标题 = 深蓝实心条 + 白字（重、像区块头）
   卡片 = 白底细描边（轻、像一个按钮）
   两者靠底色和字色一次性拉开，而不是靠字号微调。 */

/* 标题头整条换成深蓝实心 */
QFrame#WorkflowSectionHeader[sectionKey="simulation"] {
    background: #155EEF;
    border: 2px solid #155EEF;
    border-radius: 10px;
}
/* 标题字改白色。必须显式写，否则会继承通用的深蓝字，在深蓝底上看不见 */
QLabel#WorkflowSectionTitle[sectionKey="simulation"] {
    color: #FFFFFF;
    font-size: 15pt;
    font-weight: 900;
    letter-spacing: 1px;
}
/* 标题下的说明也跟着调亮 */
QLabel#WorkflowSectionHint[sectionKey="simulation"] {
    color: #D6E4FF;
}
/* 图标底色改白。图标线条本身的颜色由 Python 的 SectionSpec.accent 决定
   （这里是 "#155EEF"），深蓝底上会看不清——所以本栏的 accent 也得一起
   改成浅色。当前这一栏靠白底圆 + 深蓝图标来对比，若仍觉不够，
   把 accent 改成 "#FFFFFF" 并把这里改成透明即可。 */
QLabel#WorkflowSectionIcon[sectionKey="simulation"] {
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
}
/* 本栏的整栏底色略深一点，和另外四栏区分开（可选，不要就删掉这条） */
QFrame#WorkflowSection[sectionKey="simulation"] {
    background: #F2F7FF;
    border-color: #155EEF;
}
QFrame#SchematicCanvas {
    background: #F8FAFC;
    border: 1px solid #C7CDD6;
    border-radius: 9px;
}
QLabel#SchematicNode {
    background: #FFFFFF;
    border: 1px solid #8FB3F4;
    border-radius: 7px;
    padding: 14px 12px;
    color: #0A327A;
    font-weight: 700;
}
QFrame#TeachingEquipmentPopup {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 7px;
}
QLabel#PopupGroupTitle {
    color: #344054;
    font-weight: 750;
    padding-top: 5px;
}
QFrame#TeachingResultPopup {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
    border-radius: 8px;
}
QLabel#Teaching3DFallback {
    background: #F4F7FA;
    color: #667085;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 12px;
}
QWidget#teachingV2Inspector {
    background: #F8FAFC;
    border-left: 1px solid #D0D5DD;
}
QLabel#teachingV2SectionTitle {
    color: #101828;
    font-weight: 700;
}
QLabel#TeachingStatus {
    color: #344054;
    padding-right: 8px;
}
