    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 5px;
    background: transparent;
    padding: 0;
}
QToolButton#sectionToggle:hover { background: #D6E4FF; }
QListWidget#sectionList {
    border: 0;
