    border-radius: 7px;
    background: #F7F8FA;
    padding: 0;
}
QToolButton#collapsedPanelButton:hover { background: #D6E4FF; }
QSplitter#surfaceEditorSplitter::handle:horizontal { width: 7px; }

QTabBar::tab {
    min-height: 38px;
    padding: 0 15px;
    font-size: 13.25pt;
}
QFormLayout QLabel {
    color: #344054;
    font-size: 13.25pt;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    min-height: 38px;
    font-size: 13.25pt;
}
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    min-height: 38px;
    font-size: 12pt;
}
QHeaderView::section {
    min-height: 37px;
    font-size: 12pt;
}
QLabel#helperText {
    font-size: 12pt;
    line-height: 1.35;
}
QToolButton#navButton:focus {
    border: 1px solid #155EEF;
    border-left: 4px solid #FFFFFF;
}
QListWidget#sectionList:focus {
