QLabel#inlineMetricTitle { color: #667085; font-size: 12pt; }
QLabel#inlineMetricValue { color: #155EEF; font-size: 14pt; font-weight: 700; }
QLabel#inlineMetricUnit { color: #667085; font-size: 12pt; }
QLabel#inlineMetricNote { color: #667085; font-size: 12pt; }
QFrame#compactResultStrip { background: transparent; border: 0; }
QFrame#workspaceSurface {
    background: #FFFFFF;
    border: 1px solid #98A2B3;
